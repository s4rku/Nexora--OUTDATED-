<Page x:Class="NEXORA.Views.AIAdvisorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource NxBgBrush}">
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="HeaderPanel" Grid.Row="0" Spacing="6" Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="ChatPanel" Spacing="10"/>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox"
                     Grid.Column="0"
                     PlaceholderText="Ask NEXORA AI..."
                     FontSize="13"
                     Padding="12,10,12,10"
                     Background="{StaticResource NxSurface2Brush}"
                     Foreground="{StaticResource NxTextPriBrush}"
                     BorderBrush="{StaticResource NxBorderBrush}"
                     CornerRadius="8,0,0,8"
                     KeyDown="InputBox_KeyDown"/>
            <Button x:Name="SendBtn"
                    Grid.Column="1"
                    Content="SEND"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Padding="20,10,20,10"
                    CornerRadius="0,8,8,0"
                    Foreground="{StaticResource NxBgBrush}"
                    Click="SendBtn_Click"/>
        </Grid>
    </Grid>
</Page>
