<Page x:Class="NEXORA.Views.PcOptimizerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource NxBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="32,28,32,16" Spacing="14">
            <TextBlock Text="PC OPTIMIZER"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="28"
                       FontWeight="SemiBold"
                       CharacterSpacing="40"
                       Foreground="{StaticResource NxTextPriBrush}"/>

            <!-- Level selector + action buttons -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <RadioButton x:ConnectionId='10' x:Name="LevelSafe"
                                 Content="SAFE"
                                 GroupName="Level"
                                 Foreground="{StaticResource NxSuccessBrush}"
                                                         Tag="Safe"/>
                    <RadioButton x:ConnectionId='11' x:Name="LevelBalanced"
                                 Content="BALANCED"
                                 GroupName="Level"
                                 Foreground="{StaticResource NxAccentBrush}"
                                                         Tag="Balanced"/>
                    <RadioButton x:ConnectionId='12' x:Name="LevelPerformance"
                                 Content="PERFORMANCE"
                                 GroupName="Level"
                                 Foreground="{StaticResource NxWarningBrush}"
                                                         Tag="Performance"/>
                </StackPanel>

                <Button x:ConnectionId='8' x:Name="ScanBtn" Grid.Column="1"
                        Content="SCAN"
                        Style="{StaticResource NxOutlineBtn}"
                                             />
                <Button x:ConnectionId='9' x:Name="ApplyBtn" Grid.Column="2"
                        Content="APPLY SELECTED"
                        Style="{StaticResource NxPrimaryBtn}"
                                              
                        IsEnabled="False"/>
            </Grid>

            <TextBlock x:ConnectionId='6' x:Name="StatusText"
                       Text="Select an optimization level and click Scan."
                       FontSize="12"
                       Foreground="{StaticResource NxTextSecBrush}"/>

            <ProgressBar x:ConnectionId='7' x:Name="ProgressBar"
                         Style="{StaticResource NxBar}"
                         Value="0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Optimization list -->
        <ScrollViewer Grid.Row="1" Margin="32,0,32,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:ConnectionId='5' x:Name="OptimizationList" Spacing="6"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="32,8,32,24"
                Background="{StaticResource NxSurface1Brush}"
                BorderBrush="{StaticResource NxBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,14">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:ConnectionId='2' x:Name="FooterText"
                           Grid.Column="0"
                           Text="No optimizations loaded."
                           FontSize="12"
                           Foreground="{StaticResource NxTextSecBrush}"
                           VerticalAlignment="Center"/>
                <Button x:ConnectionId='3' x:Name="SelectAllBtn" Grid.Column="1"
                        Content="SELECT ALL"
                        Style="{StaticResource NxOutlineBtn}"
                                                  />
                <Button x:ConnectionId='4' x:Name="RollbackBtn" Grid.Column="2"
                        Content="ROLLBACK LAST"
                        Style="{StaticResource NxDangerBtn}"
                                                 
                        IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>
</Page>

