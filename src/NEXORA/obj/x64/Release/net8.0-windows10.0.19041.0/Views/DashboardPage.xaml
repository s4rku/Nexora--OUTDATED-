<Page
    x:Class="NEXORA.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource NxBgBrush}">

    <ScrollViewer>
        <StackPanel x:ConnectionId='2' x:Name="Root" Margin="32,28,32,32" Spacing="20">

            <!-- ── Header ─────────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock x:ConnectionId='15' x:Name="GreetingText"
                               Text="Good morning."
                               FontFamily="Segoe UI Variable Display"
                               FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource NxTextPriBrush}"/>
                    <TextBlock Text="Here's your system performance overview."
                               FontSize="13"
                               Foreground="{StaticResource NxTextSecBrush}"/>
                </StackPanel>
                <Button x:ConnectionId='14' x:Name="ScanBtn"
                        Grid.Column="1"
                        Content="  ↻  SCAN SYSTEM"
                        Style="{StaticResource NxOutlineBtn}"
                                             
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- ── Score hero card ────────────────────────────────────── -->
            <Border x:ConnectionId='3' x:Name="ScoreCard"
                    Background="{StaticResource NxSurface1Brush}"
                    BorderBrush="{StaticResource NxBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="28,22">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Score ring -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                        <ProgressRing x:ConnectionId='12' x:Name="ScoreRing"
                                      Width="110" Height="110"
                                      Value="78" Maximum="100"
                                      Foreground="{StaticResource NxAccentBrush}"
                                      Background="Transparent"
                                      IsIndeterminate="False"/>
                        <StackPanel HorizontalAlignment="Center" Spacing="0"
                                    Margin="0,-95,0,0">
                            <TextBlock x:ConnectionId='13' x:Name="ScoreNum"
                                       Text="78"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="36" FontWeight="Light"
                                       Foreground="{StaticResource NxAccentBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="/ 100"
                                       FontSize="10"
                                       Foreground="{StaticResource NxTextSecBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Score breakdown -->
                    <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="NEXORA SCORE"
                                       FontSize="9" FontWeight="SemiBold"
                                       CharacterSpacing="120"
                                       Foreground="{StaticResource NxTextSecBrush}"
                                       Opacity="0.7"/>
                            <TextBlock x:ConnectionId='11' x:Name="ScoreLabel"
                                       Text="Performance Score"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource NxTextPriBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="↑ 6% from last scan"
                                           FontSize="11"
                                           Foreground="{StaticResource NxSuccessBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:ConnectionId='10' x:Name="ScoreBars" Spacing="8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Hardware cards row ─────────────────────────────────── -->
            <TextBlock Text="HARDWARE"
                       FontSize="9" FontWeight="SemiBold"
                       CharacterSpacing="120"
                       Foreground="{StaticResource NxTextSecBrush}"
                       Opacity="0.7"/>
            <Grid x:ConnectionId='4' x:Name="HardwareGrid" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- ── Live performance graph ─────────────────────────────── -->
            <TextBlock Text="LIVE PERFORMANCE"
                       FontSize="9" FontWeight="SemiBold"
                       CharacterSpacing="120"
                       Foreground="{StaticResource NxTextSecBrush}"
                       Opacity="0.7"/>
            <Border Background="{StaticResource NxSurface1Brush}"
                    BorderBrush="{StaticResource NxBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="20,16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="CPU / GPU / RAM"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource NxTextPriBrush}"/>
                            <TextBlock Text="Last 2 minutes"
                                       FontSize="11"
                                       Foreground="{StaticResource NxTextSecBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#FF00C8FF" VerticalAlignment="Center"/>
                                <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource NxTextSecBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#FF7B2FFF" VerticalAlignment="Center"/>
                                <TextBlock Text="GPU" FontSize="11" Foreground="{StaticResource NxTextSecBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#FF00E676" VerticalAlignment="Center"/>
                                <TextBlock Text="RAM" FontSize="11" Foreground="{StaticResource NxTextSecBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Canvas x:ConnectionId='9' x:Name="PerfGraph" Height="120"
                                                     />
                </StackPanel>
            </Border>

            <!-- ── Bottom row: Optimize + System Status ───────────────── -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Optimize card -->
                <Border Grid.Column="0"
                        Background="{StaticResource NxSurface1Brush}"
                        BorderBrush="{StaticResource NxBorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="24,20">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="READY TO OPTIMIZE?"
                                       FontSize="9" FontWeight="SemiBold"
                                       CharacterSpacing="120"
                                       Foreground="{StaticResource NxAccentBrush}"
                                       Opacity="0.9"/>
                            <TextBlock x:ConnectionId='8' x:Name="OptimizeReadyText"
                                       Text="Scan your system to see available optimizations."
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource NxTextPriBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="A system restore point is created before any changes."
                                       FontSize="11"
                                       Foreground="{StaticResource NxTextSecBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:ConnectionId='6' x:Name="OptimizeNowBtn"
                                    Content="  ⚡  OPTIMIZE NOW"
                                    Style="{StaticResource NxPrimaryBtn}"
                                                             
                                    IsEnabled="False"/>
                            <Button x:ConnectionId='7' x:Name="ViewDetailsBtn"
                                    Content="View Details"
                                    Style="{StaticResource NxOutlineBtn}"
                                                             />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- System status -->
                <Border Grid.Column="1"
                        Background="{StaticResource NxSurface1Brush}"
                        BorderBrush="{StaticResource NxBorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="SYSTEM STATUS"
                                   FontSize="9" FontWeight="SemiBold"
                                   CharacterSpacing="120"
                                   Foreground="{StaticResource NxTextSecBrush}"
                                   Opacity="0.7"/>
                        <StackPanel x:ConnectionId='5' x:Name="StatusRows" Spacing="8"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

