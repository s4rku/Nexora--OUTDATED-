<Window
    x:Class="NEXORA.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NEXORA">

    <Grid Background="{StaticResource NxBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ SIDEBAR ═══════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource NxSurface0Brush}"
                BorderBrush="{StaticResource NxBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <!-- Geometric logo mark — two overlapping accent rectangles -->
                        <Grid Width="24" Height="24" VerticalAlignment="Center">
                            <Border Width="14" Height="14"
                                    CornerRadius="3"
                                    Background="{StaticResource NxAccentGrad}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"/>
                            <Border Width="14" Height="14"
                                    CornerRadius="3"
                                    Background="#447B2FFF"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBlock Text="NEXORA"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="17" FontWeight="Bold"
                                   CharacterSpacing="100"
                                   Foreground="{StaticResource NxTextPriBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Intelligent PC Performance"
                               FontSize="10"
                               Foreground="{StaticResource NxTextSecBrush}"
                               Margin="36,0,0,0"
                               Opacity="0.6"/>
                </StackPanel>

                <!-- Nav items -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,0,10,0" Spacing="1">

                        <TextBlock Text="MAIN"
                                   FontSize="9" FontWeight="SemiBold"
                                   CharacterSpacing="140"
                                   Foreground="{StaticResource NxTextSecBrush}"
                                   Margin="8,4,0,4" Opacity="0.5"/>

                        <!-- Nav buttons: icon drawn as a small accent rectangle, then label -->
                        <Button x:ConnectionId='4' x:Name="NavDashboard"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="Dashboard">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="16" Height="16" CornerRadius="4"
                                        Background="{StaticResource NxAccentGrad}" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='5' x:Name="NavPcOptimizer"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="PcOptimizer">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="16" Height="16" CornerRadius="8"
                                        Background="{StaticResource NxAccentGrad}" VerticalAlignment="Center"/>
                                <TextBlock Text="PC Optimizer" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='6' x:Name="NavGameOptimizer"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="GameOptimizer">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="16" Height="4" CornerRadius="2"
                                        Background="{StaticResource NxAccentGrad}" VerticalAlignment="Center"/>
                                <TextBlock Text="Game Optimizer" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='7' x:Name="NavGameLibrary"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="GameLibrary">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="16" Height="4" CornerRadius="2"
                                        Background="#447B2FFF" VerticalAlignment="Center"/>
                                <TextBlock Text="Game Library" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="TOOLS"
                                   FontSize="9" FontWeight="SemiBold"
                                   CharacterSpacing="140"
                                   Foreground="{StaticResource NxTextSecBrush}"
                                   Margin="8,12,0,4" Opacity="0.5"/>

                        <Button x:ConnectionId='8' x:Name="NavPerformance"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="Performance">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Border Width="4" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="2" Background="{StaticResource NxAccentGrad}"/>
                                    <Border Width="4" Height="14" HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="2" Background="{StaticResource NxAccentGrad}" Opacity="0.7"/>
                                    <Border Width="4" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="2" Background="{StaticResource NxAccentGrad}" Opacity="0.4"/>
                                </Grid>
                                <TextBlock Text="Performance" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='9' x:Name="NavBenchmark"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="Benchmark">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="16" Height="16" CornerRadius="8"
                                        BorderBrush="{StaticResource NxAccentBrush}"
                                        BorderThickness="2"
                                        Background="Transparent" VerticalAlignment="Center"/>
                                <TextBlock Text="Benchmark" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='10' x:Name="NavStartup"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="Startup">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="6" Height="16" CornerRadius="3"
                                        Background="{StaticResource NxAccentGrad}" VerticalAlignment="Center"/>
                                <TextBlock Text="Startup Manager" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='11' x:Name="NavProcess"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="Process">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Border Height="3" Width="16" VerticalAlignment="Top" CornerRadius="1.5" Background="{StaticResource NxAccentBrush}"/>
                                    <Border Height="3" Width="12" VerticalAlignment="Center" CornerRadius="1.5" Background="{StaticResource NxAccentBrush}" Opacity="0.6"/>
                                    <Border Height="3" Width="8" VerticalAlignment="Bottom" CornerRadius="1.5" Background="{StaticResource NxAccentBrush}" Opacity="0.3"/>
                                </Grid>
                                <TextBlock Text="Process Manager" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='12' x:Name="NavStorage"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="Storage">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="16" Height="16" CornerRadius="4"
                                        BorderBrush="{StaticResource NxAccentBrush}"
                                        BorderThickness="2"
                                        Background="Transparent" VerticalAlignment="Center">
                                    <Border Height="6" Width="8" CornerRadius="2"
                                            Background="{StaticResource NxAccentBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Margin="0,0,0,1"/>
                                </Border>
                                <TextBlock Text="Storage Cleaner" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='13' x:Name="NavNetwork"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="Network">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="16" Height="16" CornerRadius="8"
                                        BorderBrush="{StaticResource NxAccentBrush}"
                                        BorderThickness="1.5"
                                        Background="Transparent" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5"
                                             Fill="{StaticResource NxAccentBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Network" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="SYSTEM"
                                   FontSize="9" FontWeight="SemiBold"
                                   CharacterSpacing="140"
                                   Foreground="{StaticResource NxTextSecBrush}"
                                   Margin="8,12,0,4" Opacity="0.5"/>

                        <Button x:ConnectionId='14' x:Name="NavRestore"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="Restore">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="16" Height="16" CornerRadius="4"
                                        Background="#2200E676" BorderBrush="#4400E676"
                                        BorderThickness="1" VerticalAlignment="Center"/>
                                <TextBlock Text="Restore Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='15' x:Name="NavHistory"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="History">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="16" Height="16" CornerRadius="8"
                                        BorderBrush="#FF8894AA" BorderThickness="1.5"
                                        Background="Transparent" VerticalAlignment="Center"/>
                                <TextBlock Text="History" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='16' x:Name="NavAI"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="AI">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="16" Height="16" CornerRadius="4"
                                        Background="{StaticResource NxAccentGrad}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="AI" FontSize="7" FontWeight="Bold"
                                               Foreground="#FF090A0F"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="NEXORA AI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='17' x:Name="NavSettings"
                                Style="{StaticResource NavBtnStyle}"
                                                        Tag="Settings">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Ellipse Width="16" Height="16"
                                         StrokeThickness="2"
                                         Stroke="#FF8894AA"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="16,8,16,16">
                    <Border Height="1" Background="{StaticResource NxBorderBrush}"
                            Opacity="0.5" Margin="0,0,0,10"/>
                    <TextBlock Text="v1.0.0" FontSize="10"
                               Foreground="{StaticResource NxTextSecBrush}" Opacity="0.4"/>
                    <TextBlock x:ConnectionId='3' x:Name="StatusText" Text="Ready" FontSize="10"
                               Foreground="{StaticResource NxSuccessBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ CONTENT ═══════════════════════════════════════════════════ -->
        <Frame x:ConnectionId='2' x:Name="ContentFrame" Grid.Column="1"
               Background="{StaticResource NxBgBrush}"/>
    </Grid>
</Window>

